{"type":"item.started","item":{"id":"item_252","type":"command_execution","command":"/bin/bash -lc \"pwd; source .venv/bin/activate; python - <<'PY'\nfrom pathlib import Path\np=Path('src/choice_likelihood.py');s=p.read_text();s=s.replace(\\\"out={'intervention_contrasts':intervention_contrasts\\\", \\\"clean=[]\\\\n    metrics=pd.read_csv('results/story_metrics.csv')\\\\n    for condition,r in p[(p.study=='main')&(p.task=='word')].groupby('condition'):\\\\n        bad=set(metrics[(metrics.task=='word')&(metrics.condition==condition)&(metrics.literal_leak==True)].unit)\\\\n        z=r[~r.unit.isin(bad)]\\\\n        clean.append({'condition':condition,**estimate(z.score,center=.5),'note':'Post-treatment literal exclusion; descriptive only.'})\\\\n    out={'without_literal_pairs':clean,'exact_log_odds_ties':int((p.log_odds==0).sum()),'intervention_contrasts':intervention_contrasts\\\")\np.write_text(s)\nPY\nuv pip freeze --python .venv/bin/python > requirements.txt\npython - <<'PY'\nimport json,re\nr=[json.loads(x) for x in open('results/model_outputs/anchor_stories.jsonl')]\nfor present in [True,False]:\n s=[x for x in r if x['secret_present']==present];print('anchor literal',present,sum(bool(re.search(r'\\\\b'+re.escape(x['secret'])+r'\\\\b',x['text'],re.I)) for x in s),len(s))\nPY\ntail -2 logs/choice_likelihood.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
