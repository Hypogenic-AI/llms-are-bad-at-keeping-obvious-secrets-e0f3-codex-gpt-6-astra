{"type":"item.started","item":{"id":"item_225","type":"command_execution","command":"/bin/bash -lc \"pwd; cat > src/probe_literal_association.py <<'PY'\n\\\"\\\"\\\"Secondary association of early readouts with later exact-word disclosure.\nExcludes outputs with an exact word already in the first 15% of characters as a\nconservative text-based screen, not a token-exact temporal exclusion. Replayed\nstates are approximations to original generation. This is not causal mediation.\n\\\"\\\"\\\"\nimport json,re\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import spearmanr\nfrom statsmodels.stats.multitest import multipletests\nfrom analyze import SEED\n\ndef main():\n    states=pd.DataFrame(json.loads(Path('results/mechanism/free_scores.json').read_text()))\n    s=pd.read_csv('results/story_metrics.csv');s=s[(s.task=='word')&s.secret_present].copy()\n    s['early_literal']=[bool(re.search(r'\\\\b'+re.escape(w)+r'\\\\b',text[:int(.15*len(text))],re.I)) for w,text in zip(s.secret,s.text)]\n    joined=states[(states.fraction==.1)&states.secret_present].merge(s[['id','literal_leak','early_literal']],on='id');joined=joined[~joined.early_literal]\n    out=[]\n    for c,d in joined.groupby('condition'):\n        x=(d.margin-d.groupby('family').margin.transform('mean')).to_numpy();raw=d.literal_leak.astype(float);y=(raw-raw.groupby(d.family).transform('mean')).to_numpy()\n        rho=None;p=None\n        if np.std(x)>0 and np.std(y)>0:\n            rho=float(spearmanr(x,y).statistic);rng=np.random.default_rng(SEED);groups=list(d.groupby('family').indices.values());null=[]\n            for _ in range(5000):\n                z=y.copy()\n                for ix in groups:z[ix]=rng.permutation(z[ix])\n                null.append(spearmanr(x,z).statistic)\n            p=float((1+(np.abs(null)>=abs(rho)).sum())/5001)\n        out.append({'condition':c,'n':len(d),'n_later_literal':int(raw.sum()),'within_secret_spearman_r':rho,'p':p})\n    valid=[r for r in out if r['p'] is not None]\n    for r,p in zip(valid,multipletests([r['p'] for r in valid],method='holm')[1] if valid else []):r['p_holm']=float(p)\n    Path('results/mechanism/early_literal_association.json').write_text(json.dumps({'secondary_post_hoc':True,'summaries':out,'caveat':__doc__},indent=2));print(out)\nif __name__=='__main__':main()\nPY\nsource .venv/bin/activate; python -m py_compile src/probe_literal_association.py\ncat >> notes/planning_history.md <<'EOF'\nAfter detecting frequent late literal disclosures but before probe results, specify a secondary association between the fixed decoder's 10%-position margin and subsequent exact-word disclosure in disjoint story units. Screen out stories already mentioning the word in their first 15% of characters (approximate, conservative screen rather than token-exact alignment), center within secret, and use within-secret permutations/Holm across three conditions. This is a descriptive availability–disclosure association, not causal mediation or a replacement for the planned judge-score association.\nEOF\ntail -4 logs/mechanism_extract.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_225","type":"command_execution","command":"/bin/bash -lc \"pwd; cat > src/probe_literal_association.py <<'PY'\n\\\"\\\"\\\"Secondary association of early readouts with later exact-word disclosure.\nExcludes outputs with an exact word already in the first 15% of characters as a\nconservative text-based screen, not a token-exact temporal exclusion. Replayed\nstates are approximations to original generation. This is not causal mediation.\n\\\"\\\"\\\"\nimport json,re\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.stats import spearmanr\nfrom statsmodels.stats.multitest import multipletests\nfrom analyze import SEED\n\ndef main():\n    states=pd.DataFrame(json.loads(Path('results/mechanism/free_scores.json').read_text()))\n    s=pd.read_csv('results/story_metrics.csv');s=s[(s.task=='word')&s.secret_present].copy()\n    s['early_literal']=[bool(re.search(r'\\\\b'+re.escape(w)+r'\\\\b',text[:int(.15*len(text))],re.I)) for w,text in zip(s.secret,s.text)]\n    joined=states[(states.fraction==.1)&states.secret_present].merge(s[['id','literal_leak','early_literal']],on='id');joined=joined[~joined.early_literal]\n    out=[]\n    for c,d in joined.groupby('condition'):\n        x=(d.margin-d.groupby('family').margin.transform('mean')).to_numpy();raw=d.literal_leak.astype(float);y=(raw-raw.groupby(d.family).transform('mean')).to_numpy()\n        rho=None;p=None\n        if np.std(x)>0 and np.std(y)>0:\n            rho=float(spearmanr(x,y).statistic);rng=np.random.default_rng(SEED);groups=list(d.groupby('family').indices.values());null=[]\n            for _ in range(5000):\n                z=y.copy()\n                for ix in groups:z[ix]=rng.permutation(z[ix])\n                null.append(spearmanr(x,z).statistic)\n            p=float((1+(np.abs(null)>=abs(rho)).sum())/5001)\n        out.append({'condition':c,'n':len(d),'n_later_literal':int(raw.sum()),'within_secret_spearman_r':rho,'p':p})\n    valid=[r for r in out if r['p'] is not None]\n    for r,p in zip(valid,multipletests([r['p'] for r in valid],method='holm')[1] if valid else []):r['p_holm']=float(p)\n    Path('results/mechanism/early_literal_association.json').write_text(json.dumps({'secondary_post_hoc':True,'summaries':out,'caveat':__doc__},indent=2));print(out)\nif __name__=='__main__':main()\nPY\nsource .venv/bin/activate; python -m py_compile src/probe_literal_association.py\ncat >> notes/planning_history.md <<'EOF'\nAfter detecting frequent late literal disclosures but before probe results, specify a secondary association between the fixed decoder's 10%-position margin and subsequent exact-word disclosure in disjoint story units. Screen out stories already mentioning the word in their first 15% of characters (approximate, conservative screen rather than token-exact alignment), center within secret, and use within-secret permutations/Holm across three conditions. This is a descriptive availability–disclosure association, not causal mediation or a replacement for the planned judge-score association.\nEOF\ntail -4 logs/mechanism_extract.log\"","aggregated_output":"/workspaces/llms-are-bad-at-keeping-obvious-secrets-e0f3-codex-gpt-6-astra\nprobe 420 1080 elapsed 91\nprobe 480 1080 elapsed 104\nprobe 540 1080 elapsed 117\nprobe 600 1080 elapsed 130\n","exit_code":0,"status":"completed"}}
